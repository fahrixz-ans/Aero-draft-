# =============================================================================
# AERO APK PRODUCTION ENVIRONMENT VARIABLE CHECKLIST & CONFIGURATION MATRIX
# =============================================================================

# Server & Node Runtime
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://aeroapk.com,https://www.aeroapk.com

# -----------------------------------------------------------------------------
# 1. AUTHENTICATION (AUTH.JS - SOLE AUTH SYSTEM)
# -----------------------------------------------------------------------------
AUTH_SECRET=your_32_byte_secure_random_auth_secret_here
AUTH_URL=https://aeroapk.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# -----------------------------------------------------------------------------
# 2. FIRESTORE DATABASE (PERSISTENCE ONLY - NO AUTH)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=ai-studio-aeroapk-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@ai-studio-aeroapk-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# 3. APK STORAGE & DELIVERY (DOSYA.DEV & GOOGLE CLOUD STORAGE)
# -----------------------------------------------------------------------------
DOSYA_API_KEY=ISI_API_KEY_DOSYA_DEV_DI_VERCEL
GCS_PROJECT_ID=your_gcs_project_id
GCS_BUCKET_NAME=aeroapk-apk-production
GCS_CLIENT_EMAIL=gcs-uploader@your-project-id.iam.gserviceaccount.com
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_GCS_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
GCS_PUBLIC_BASE_URL=https://storage.googleapis.com/aeroapk-apk-production

# -----------------------------------------------------------------------------
# 4. IMAGE STORAGE & ASSET MANAGEMENT (CLOUDINARY)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# 5. APK SECURITY SCANNING (VIRUSTOTAL)
# -----------------------------------------------------------------------------
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# -----------------------------------------------------------------------------
# 6. AI INTELLIGENCE & API KEYS (SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_server_only
OPENAI_API_KEY=your_openai_api_key_for_famo_cs

# -----------------------------------------------------------------------------
# 7. PERFORMANCE, CACHE & TIMEOUTS
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL=300
PERFORMANCE_SLOW_THRESHOLD_MS=500
PERFORMANCE_CRITICAL_THRESHOLD_MS=1000

# -----------------------------------------------------------------------------
# 8. BACKGROUND WORKER RUNTIME & QUEUES
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_TIMEOUT_MS=60000
WORKER_MAX_RETRIES=3
WORKER_BATCH_SIZE=10

# -----------------------------------------------------------------------------
# 9. FEATURE FLAGS & EMERGENCY KILL SWITCHES
# -----------------------------------------------------------------------------
RECOMMENDATION_ENABLED=true
RANKING_ENABLED=true
SMART_COLLECTIONS_ENABLED=true
ANALYTICS_ENABLED=true
APK_UPLOAD_ENABLED=true
APK_DOWNLOAD_ENABLED=true
DEVELOPER_UPLOAD_ENABLED=true
GOOGLE_LOGIN_ENABLED=true
