# =============================================================================
# MOD STATION PRODUCTION ENVIRONMENT VARIABLE CONFIGURATION MATRIX
# =============================================================================

# Server & Node Runtime
NODE_ENV=production
PORT=3000
ALLOWED_ORIGINS=https://fantra.modstatition.vercel.app

# -----------------------------------------------------------------------------
# 1. AUTHENTICATION (AUTH.JS - SOLE AUTH SYSTEM)
# -----------------------------------------------------------------------------
AUTH_SECRET=your_32_byte_secure_random_auth_secret_here
AUTH_URL=https://fantra.modstatition.vercel.app
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# -----------------------------------------------------------------------------
# 2. FIRESTORE DATABASE (PERSISTENCE ONLY - NO AUTH)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=mod-station-prod
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@mod-station-prod.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------------------------------------
# 3. IMAGE STORAGE & ASSET MANAGEMENT (CLOUDINARY)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# -----------------------------------------------------------------------------
# 4. AI ASSISTANT (OPENAI CHATGPT API - SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_server_only

# -----------------------------------------------------------------------------
# 5. AI CUSTOMER SERVICE (GOOGLE GEMINI API - SERVER-SIDE ONLY)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_server_only

# -----------------------------------------------------------------------------
# 6. NOTIFICATION & MESSAGING (FIREBASE CLOUD MESSAGING / FCM)
# -----------------------------------------------------------------------------
FIREBASE_MESSAGING_VAPID_KEY=your_fcm_vapid_key

# -----------------------------------------------------------------------------
# 7. PERFORMANCE, CACHE & TIMEOUTS
# -----------------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL=300
PERFORMANCE_SLOW_THRESHOLD_MS=500
PERFORMANCE_CRITICAL_THRESHOLD_MS=1000

# -----------------------------------------------------------------------------
# 8. BACKGROUND WORKER RUNTIME & QUEUES
# -----------------------------------------------------------------------------
WORKER_CONCURRENCY=5
WORKER_TIMEOUT_MS=60000
WORKER_MAX_RETRIES=3
WORKER_BATCH_SIZE=10

# -----------------------------------------------------------------------------
# 9. FEATURE FLAGS & EMERGENCY KILL SWITCHES
# -----------------------------------------------------------------------------
RECOMMENDATION_ENABLED=true
RANKING_ENABLED=true
SMART_COLLECTIONS_ENABLED=true
ANALYTICS_ENABLED=true
APK_UPLOAD_ENABLED=true
APK_DOWNLOAD_ENABLED=true
DEVELOPER_UPLOAD_ENABLED=true
GOOGLE_LOGIN_ENABLED=true

# -----------------------------------------------------------------------------
# 10. SEO & GOOGLE ADSENSE INTEGRATION
# -----------------------------------------------------------------------------
VITE_GSC_VERIFICATION=
VITE_ADSENSE_CLIENT_ID=
ADSENSE_PUBLISHER_ID=
